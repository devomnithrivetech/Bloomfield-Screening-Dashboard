# ===== Supabase =====
# Project URL — Supabase dashboard → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Public anon key — Supabase dashboard → Project Settings → API → "anon public"
VITE_SUPABASE_ANON_KEY=

# ===== Site URL =====
# Production URL used in confirmation/reset emails — ensures links work when email is sent from localhost dev
# Set to your deployed frontend URL (e.g. https://dashboard.bloomfieldcapital.com)
VITE_SITE_URL=

# ===== Backend API =====
VITE_API_BASE_URL=http://localhost:8000
